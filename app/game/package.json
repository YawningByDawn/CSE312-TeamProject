{
  "name": "hungry-god-inc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "workshop": "vite --mode workshop --host 127.0.0.1 --port 5298 --strictPort",
    "build": "tsc --noEmit && vite build --mode course",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --changed ${BASE:-main}",
    "bots": "tsx scripts/bots/table.ts",
    "test:all": "vitest run",
    "test:slow": "SLOW=1 vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.56.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  }
}
